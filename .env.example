# Copy to .env. Only the scripts that send testnet transactions (testnet.js, revoke_lag.js, vc_demo.js) need
# PRIVATE_KEY; use a key that holds testnet funds only. The scripts never print it.
PRIVATE_KEY=
# RPC endpoints for the measurement scripts. SEPOLIA_RPC_URL is required for NET=sepolia; OP_RPC and ARB_RPC fall
# back to public endpoints when empty.
SEPOLIA_RPC_URL=
OP_RPC=
ARB_RPC=
# read-only mainnet fee sampler (scripts/mainnet_fee_sampler.js)
ETH_MAINNET_RPC=
OPMAIN_RPC=
ARB1_RPC=
# The read-only tools in tools/ take SEPOLIA_RPC, OP_RPC and ARB_RPC from the environment, not from this file.
